# ===== Servidor =====
PORT=3000
# Fuso horário usado nas rotinas e nas datas
TZ=America/Sao_Paulo

# ===== WhatsApp Cloud API (Meta) =====
# Painel: developers.facebook.com > seu app > WhatsApp > Configuração da API
WHATSAPP_TOKEN=coloque_o_token_permanente_aqui
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Senha que você inventa e digita também no painel da Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN=invente_uma_senha_longa
# Painel: Configurações do app > Básico > Chave secreta do app (valida que o webhook veio mesmo da Meta)
WHATSAPP_APP_SECRET=chave_secreta_do_app
WHATSAPP_API_VERSION=v23.0
# true = não envia nada de verdade, só mostra no log (bom para testar)
WHATSAPP_DRY_RUN=false

# ===== Claude (Anthropic) =====
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5

# ===== Google Sheets =====
# ID da planilha (o trecho entre /d/ e /edit na URL)
GOOGLE_SHEET_ID=
# Conteúdo do JSON da conta de serviço do Google, em uma linha OU em base64
GOOGLE_SERVICE_ACCOUNT_JSON=

# ===== Rotinas automáticas =====
# true = o próprio servidor dispara cobranças/acompanhamentos/lembretes nos horários
ROTINAS_ATIVAS=true
# Senha para disparar as rotinas por URL (POST /rotinas/executar) a partir de um cron externo
ROTINAS_TOKEN=invente_outra_senha
